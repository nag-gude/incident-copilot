# Copy this file to .env and fill in your keys for local / Docker Compose runs.
# docker-compose reads .env from the project root automatically.

# You.com API – required for live citation-backed remediation (otherwise you see "You.com API not configured").
# Get a key: https://you.com/resources/hackathon or You.com Developer Portal
YOUCOM_API_KEY=

# Optional: Sanity – similar incidents & structured content (dashboard "Similar" section)
# Get project ID: https://www.sanity.io/get-started . See docs/INTEGRATIONS.md and docs/DEPLOYMENT-LOCAL.md.
# SANITY_PROJECT_ID=
# SANITY_DATASET=production
# SANITY_TOKEN=
